# Base de données Neon (pooler pour l'app, connexion directe pour les migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth : secret aléatoire (openssl rand -base64 32) et URL publique du déploiement
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://kamply-platform.vercel.app

# E-mails comptes administrateurs à la création (séparés par des virgules)
ADMIN_EMAILS=

# Resend (sans domaine vérifié : expéditeur onboarding@resend.dev, envoi vers l'e-mail du compte Resend uniquement)
RESEND_API_KEY=
# EMAIL_FROM="KAMPLY <noreply@kamply.com>"
# EMAIL_DEV_LOG=1

# Google Gen AI (Gemini) : génération des campagnes à partir du site
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Adresse de réponse des e-mails envoyés depuis l'admin
# EMAIL_REPLY_TO=contact@kamply.com

# Cloudinary : cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Coordonnées bancaires affichées pour les recharges
NEXT_PUBLIC_BANK_HOLDER=
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_BIC=

NEXT_PUBLIC_SITE_URL=https://kamply-platform.vercel.app
