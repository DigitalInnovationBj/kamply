# Base de données Neon (pooler pour l'app, connexion directe pour les migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth : secret aléatoire (openssl rand -base64 32) et URL publique du déploiement
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.kamply.site

# E-mails comptes administrateurs à la création (séparés par des virgules)
ADMIN_EMAILS=

# Resend (domaine kamply.site vérifié)
RESEND_API_KEY=
# EMAIL_FROM="KAMPLY <noreply@kamply.site>"
# EMAIL_DEV_LOG=1

# Google Gen AI (Gemini) : génération des campagnes à partir du site
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Adresse de réponse des e-mails envoyés depuis l'admin
EMAIL_REPLY_TO=contact@kamply.site

# Cloudinary : cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# GeniusPay : paiement des recharges par carte (Visa, Mastercard)
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant

# Virement bancaire (désactivé) : BANK_TRANSFER_ENABLED=1 et coordonnées NEXT_PUBLIC_BANK_*

NEXT_PUBLIC_SITE_URL=https://www.kamply.site
